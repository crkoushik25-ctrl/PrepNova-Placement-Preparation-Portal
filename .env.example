# Environment Variables Example Configuration
# Copy this file to .env for local testing or set these variables in Render Dashboard

SECRET_KEY=django-insecure-replace-with-a-secure-random-secret-key
DEBUG=True
DATABASE_URL=postgresql://username:password@hostname:5432/dbname
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,.onrender.com
RENDER_EXTERNAL_HOSTNAME=prepnova-portal.onrender.com
DB_PATH=
